[Unit]
Description=KORLA.cloud DynDNS Update Service
After=network.target

[Service]
User=kdyndns
Group=kdyndns

Environment="KDYNDNS_CONFIG=/etc/kdyndns/config.toml"
Environment="RUST_LOG=info"

ExecStart=/usr/bin/kdyndns
ExecReload=/bin/kill -SIGUSR1 $MAINPID
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

# journald-kompatibel
StandardOutput=journal
StandardError=journal

# Restart Policy
Restart=on-failure
RestartSec=5s